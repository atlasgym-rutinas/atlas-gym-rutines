  "glossary": [
    {
      "term": "R.E.",
      "text": "Repeticiones estables: una serie de 15 repeticiones con peso intermedio a bajo y después 3 series de 10 con un peso mayor (15/10/10/10)."
    },
    {
      "term": "R.D.",
      "text": "Pirámide o repeticiones descendentes: empezás con 12 repeticiones con peso intermedio y, a medida que bajan las repeticiones, subís el peso (12/10/8). Descanso de 90 segundos entre series."
    }
  ]
